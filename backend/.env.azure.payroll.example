PAYROLL_DATABASE_URL=mysql+pymysql://payroll_app:change-me@your-server.mysql.database.azure.com:3306/unisan_db?charset=utf8mb4
PAYROLL_DB_SSL_CA=/home/site/wwwroot/backend/certs/DigiCertGlobalRootCA.crt.pem
PAYROLL_JWT_SECRET=replace-with-at-least-32-random-characters
PAYROLL_ACCESS_TOKEN_MINUTES=480
PAYROLL_CORS_ORIGINS=https://your-domain/payroll,https://your-domain
PAYROLL_BOOTSTRAP_ADMIN_USERNAME=
PAYROLL_BOOTSTRAP_ADMIN_PASSWORD=
PAYROLL_BOOTSTRAP_ADMIN_NAME=Administrador
PAYROLL_GUNICORN_WORKERS=2
PAYROLL_GUNICORN_TIMEOUT=120
